# litellm-proxy connection for the optional network steps:
#   --summary  (src/llm/summarize.js)  text-only one-line caption of the batch metadata
#   --vision   (src/vision/describe.js) per-photo AI content caption + tags from the pixels
# The deterministic organize/watermark/contact-sheet/gallery pipeline never reads these -- it
# works with none of this set. Only `--summary` / `--vision` touch the network.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-changeme
LITELLM_DEFAULT_MODEL=local-devstral-small2

# Optional: model used specifically for --vision. Defaults to LITELLM_DEFAULT_MODEL when unset.
# On the shared demo deployment the API key is scoped to local-devstral-small2, which -- as
# proxied -- accepts OpenAI-vision image_url input and describes real pixels, so the default works.
# Point this at a dedicated VLM (e.g. local-llava, Qwen2.5-VL) on a deployment whose key allows it.
# LITELLM_VISION_MODEL=local-llava
